RESTIC_REPOSITORY="rest:http://{{ restic_name }}:{{ restic_rest_passwords[restic_name] }}@{{ restic_server }}:8000/{{ restic_name }}/"
RESTIC_PASSWORD_FILE="/etc/restic/password"
RESTIC_CACHE_DIR="/var/cache/restic"
GATUS_URL="http://{{ restic_server }}:8080/api/v1/endpoints/backups_{{ restic_name }}/external"
GATUS_TOKEN="{{ restic_gatus_token }}"
{% for key, value in restic_env.items() %}
{{ key }}="{{ value }}"
{% endfor %}
