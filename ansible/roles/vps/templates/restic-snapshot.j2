#!/bin/bash
# {{ ansible_managed }}
set -euo pipefail

report() {
  curl -fsS -m 30 -o /dev/null -X POST -H "Authorization: Bearer $BACKUP_HEARTBEAT_TOKEN" "http://127.0.0.1:8080/api/v1/endpoints/backups_snapshots/external?success=$1${2:+&error=$2}" || true
}
trap 'report false "snapshot+failed"' ERR

dest=/data/snapshots/$(date -u +%F)
rm -rf /data/snapshots/*.tmp
if [ ! -e "$dest" ]; then
  cp -a --reflink=always /data/restic "$dest.tmp"
  mv "$dest.tmp" "$dest"
fi
find /data/snapshots -mindepth 1 -maxdepth 1 | sort | head -n -{{ vps_restic_snapshots }} | xargs -r rm -rf

report true
