# Rendered by add-host.sh — one Let's Encrypt cert per host (no wildcard).
# Placeholders: {{FQDN}} = server name, {{UPSTREAM}} = backend URL.
server {
    listen 80;
    server_name {{FQDN}};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name {{FQDN}};

    ssl_certificate     /etc/letsencrypt/live/{{FQDN}}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{FQDN}}/privkey.pem;

    location / {
        # Upstream serves its own (self-signed) cert; we terminate the trusted
        # one here and don't verify the backend.
        proxy_pass       {{UPSTREAM}};
        proxy_ssl_verify off;

        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_buffering    off;
        client_max_body_size 0;      # allow large uploads (ISOs, datasets, etc.)
        proxy_read_timeout 3600s;    # keep long-lived console/websocket sessions
        proxy_send_timeout 3600s;
    }
}
